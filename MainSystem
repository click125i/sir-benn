try:
    from PIL import Image, ImageTk
    PIL_OK = True
except ImportError:
    PIL_OK = False

# ----------------------------------------------------------------------------
# Data / settings
# ----------------------------------------------------------------------------
FOLDER = os.path.dirname(os.path.abspath(__file__))
BOOKINGS_FILE = os.path.join(FOLDER, "bookings.json")
RECEIPT_DIR = os.path.join(FOLDER, "receipts")

HOTEL_NAME = "Esmiringhoy Hotel"
VAT_RATE = 0.12
EXTRA_GUEST_FEE = 500          # per extra guest, per night (beyond included guests)
MAX_NIGHTS = 30
MAX_DAYS_AHEAD = 365
PAYMENT_METHODS = ["ONLINE", "CASH", "BANKING"]

ROOMS = {
    "Masters bedroom": {
        "rate": 8500, "included": 4, "max": 6, "total": 3,
        "specs": "65 sqm | 2 King beds | Living area | Jacuzzi | Balcony | Smart TV | Free Wi-Fi",
    },
    "Class A": {
        "rate": 5500, "included": 3, "max": 4, "total": 5,
        "specs": "42 sqm | 1 King + 1 Single bed | Air-con | Smart TV | Mini fridge | Free Wi-Fi",
    },
    "Class B": {
        "rate": 3500, "included": 2, "max": 3, "total": 8,
        "specs": "30 sqm | 1 Queen bed | Air-con | Cable TV | Private bathroom | Free Wi-Fi",
    },
    "Regular": {
        "rate": 2000, "included": 2, "max": 2, "total": 10,
        "specs": "22 sqm | 1 Double bed | Electric fan | Cable TV | Private bathroom",
    },
}
ROOM_NAMES = list(ROOMS.keys())

# ----------------------------------------------------------------------------
# Storage helpers
# ----------------------------------------------------------------------------
def load_bookings():
    if not os.path.exists(BOOKINGS_FILE):
        return []
    try:
        with open(BOOKINGS_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, list):
            raise ValueError("bookings file is not a list")
        return data
    except (json.JSONDecodeError, ValueError, OSError):
        # Keep the unreadable file as a backup and start fresh
        try:
            os.replace(BOOKINGS_FILE, BOOKINGS_FILE + ".bak")
        except OSError:
            pass
        messagebox.showwarning(
            "Bookings file problem",
            "The bookings file could not be read. A backup (.bak) was kept "
            "and a new empty list was started.")
        return []


def save_bookings():
    try:
        with open(BOOKINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(bookings, f, indent=2)
        return True
    except OSError as e:
        messagebox.showerror("Save error", f"Could not save the reservation:\n{e}")
        return False


bookings = []   # filled after the Tk root exists (messagebox needs a root)

# ----------------------------------------------------------------------------
# Business logic
# ----------------------------------------------------------------------------
def parse_date(s):
    s = s.strip()
    if not s:
        raise ValueError("Date of reservation is required (MONTH/DAY/YEAR, e.g. 12/25/2026).")
    try:
        return datetime.strptime(s, "%m/%d/%Y").date()
    except ValueError:
        raise ValueError("Invalid date. Use MONTH/DAY/YEAR, e.g. 12/25/2026 (must be a real date).")


def parse_time(s):
    s = s.strip().upper().replace(" ", "")
    if not s:
        raise ValueError("Time of reservation is required (e.g. 7:00AM).")
    for fmt in ("%I:%M%p", "%I%p"):
        try:
            return datetime.strptime(s, fmt).time()
        except ValueError:
            continue
    raise ValueError("Invalid time. Use a format like 7:00AM or 2:30PM.")


def parse_int(s, label, lo, hi):
    s = s.strip()
    if not s:
        raise ValueError(f"{label} is required.")
    if not s.isdigit():
        raise ValueError(f"{label} must be a whole number.")
    n = int(s)
    if not lo <= n <= hi:
        raise ValueError(f"{label} must be between {lo} and {hi}.")
    return n


def rooms_left(room, start, end, ignore_ref=None):
    """How many rooms of this type are free for [start, end)."""
    used = 0
    for b in bookings:
        if b["room"] != room or b["ref"] == ignore_ref:
            continue
        b_start = date.fromisoformat(b["checkin"])
        b_end = date.fromisoformat(b["checkout"])
        if b_start < end and start < b_end:
            used += 1
    return ROOMS[room]["total"] - used


def compute_price(room, nights, guests):
    r = ROOMS[room]
    base = r["rate"] * nights
    extra_guests = max(0, guests - r["included"])
    extra = extra_guests * EXTRA_GUEST_FEE * nights
    subtotal = base + extra
    disc_pct = 0.10 if nights >= 5 else 0.05 if nights >= 3 else 0.0
    discount = subtotal * disc_pct
    taxable = subtotal - discount
    vat = taxable * VAT_RATE
    return {
        "rate": r["rate"], "base": base, "extra_guests": extra_guests, "extra": extra,
        "subtotal": subtotal, "disc_pct": disc_pct, "discount": discount,
        "vat": vat, "total": taxable + vat,
    }


def new_reference():
    existing = {b["ref"] for b in bookings}
    while True:
        ref = "ESM-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
        if ref not in existing:
            return ref


def peso(x):
    return f"PHP {x:,.2f}"


def build_receipt(b):
    p = compute_price(b["room"], b["nights"], b["guests"])
    ci = date.fromisoformat(b["checkin"])
    co = date.fromisoformat(b["checkout"])
    w = 50
    line = "=" * w
    dash = "-" * w

    def row(label, value):
        return f"{label:<26}{value:>{w - 26}}"

    out = [
        line,
        HOTEL_NAME.upper().center(w),
        "OFFICIAL RESERVATION RECEIPT".center(w),
        line,
        f"Reference No : {b['ref']}",
        f"Issued       : {b['created']}",
        dash,
        f"Guest        : {b['name']}",
        f"Contact No.  : {b['contact']}",
        f"Payment      : {b['payment']}",
        dash,
        f"Room         : {b['room']}",
        f"Specs        : {ROOMS[b['room']]['specs'][:36]}",
        f"Check-in     : {ci.strftime('%b %d, %Y')} at {b['time']}",
        f"Check-out    : {co.strftime('%b %d, %Y')}",
        f"Length of stay: {b['nights']} night(s)",
        f"No. of guests: {b['guests']}",
    ]
    if b.get("requests"):
        out.append(f"Requests     : {b['requests'][:36]}")
    out.append(dash)
    out.append(row(f"Room rate x {b['nights']} night(s)", peso(p["base"])))
    if p["extra_guests"]:
        out.append(row(f"Extra guest x{p['extra_guests']}", peso(p["extra"])))
    if p["discount"]:
        out.append(row(f"Discount ({int(p['disc_pct'] * 100)}%)", "-" + peso(p["discount"])))
    out.append(row("VAT (12%)", peso(p["vat"])))
    out.append(dash)
    out.append(row("TOTAL AMOUNT DUE", peso(p["total"])))
    out.append(line)
    out.append("Thank you for choosing Esmiringhoy Hotel!".center(w))
    out.append("Please present this receipt upon check-in.".center(w))
    out.append(line)
    return "\n".join(out)


# ----------------------------------------------------------------------------
# Window / canvas setup
# ----------------------------------------------------------------------------
window = tk.Tk()
window.title("Room Reservation Management")

SCREEN_W, SCREEN_H = window.winfo_screenwidth(), window.winfo_screenheight()
W = min(1500, SCREEN_W - 40)
H = min(1000, SCREEN_H - 100)
window.geometry(f"{W}x{H}")
window.resizable(False, False)
CX = W // 2


def Y(v):
    """Scale a y position designed for a 1000px-high window."""
    return int(v * H / 1000)


bookings.extend(load_bookings())

bg = None
if PIL_OK:
    try:
        img = Image.open(os.path.join(FOLDER, "hotelbg.jpg")).resize((W, H))
        bg = ImageTk.PhotoImage(img)
    except (FileNotFoundError, OSError):
        bg = None

canvas = tk.Canvas(window, width=W, height=H, highlightthickness=0)
canvas.pack(fill="both", expand=True)

widgets = []   # real tk widgets placed on the canvas (destroyed on screen change)
booking = {}   # data collected while the user moves between screens


def draw_bg():
    if bg:
        canvas.create_image(0, 0, image=bg, anchor="nw")
    else:  # simple blue gradient fallback
        bands = 100
        for i in range(bands):
            c = int(30 + 90 * i / bands)
            canvas.create_rectangle(0, i * H / bands, W, (i + 1) * H / bands + 1,
                                    fill=f"#{c // 3:02x}{c // 2:02x}{c + 40:02x}", outline="")


def clear():
    for w in widgets:
        w.destroy()
    widgets.clear()
    canvas.delete("all")
    draw_bg()


def text(x, y, msg, size=16, anchor="center", tags=(), font="Arial", color="white"):
    y = Y(y)
    canvas.create_text(x + 2, y + 2, text=msg, font=(font, size, "bold"),
                       fill="black", anchor=anchor, tags=tags)
    canvas.create_text(x, y, text=msg, font=(font, size, "bold"),
                       fill=color, anchor=anchor, tags=tags)


def panel(x1, y1, x2, y2):
    canvas.create_rectangle(x1, Y(y1), x2, Y(y2), fill="black",
                            stipple="gray50", outline="white", width=2)


def place(x, y, widget):
    canvas.create_window(x, Y(y), window=widget)
    widgets.append(widget)
    return widget


def entry(x, y, value="", width=30):
    e = tk.Entry(window, font=("Arial", 14), width=width)
    e.insert(0, value)
    return place(x, y, e)


def combo(x, y, values, value="", width=28):
    c = ttk.Combobox(window, values=values, state="readonly",
                     font=("Arial", 14), width=width)
    if value in values:
        c.set(value)
    return place(x, y, c)


def button(x, y, label, cmd, width=16):
    b = tk.Button(window, text=label, font=("Arial", 14, "bold"), width=width, command=cmd)
    return place(x, y, b)


# ----------------------------------------------------------------------------
# Screen 1: choose room, dates, nights, guests
# ----------------------------------------------------------------------------
def draw_availability(start, nights):
    canvas.delete("avail")
    end = start + timedelta(days=nights)
    text(CX + 270, 190,
         f"Available for {start.strftime('%b %d')} - {end.strftime('%b %d, %Y')}",
         12, "center", ("avail",), color="#ffe08a")
    for i, name in enumerate(ROOM_NAMES):
        left = rooms_left(name, start, end)
        label = f"{left} / {ROOMS[name]['total']}" if left > 0 else "FULL"
        text(CX + 270, 250 + i * 55, label, 14, "center", ("avail",),
             color="#7CFC9A" if left > 0 else "#ff7b7b")


def screen_booking():
    clear()
    text(CX, 55, HOTEL_NAME.upper(), 30)
    text(CX, 105, "Welcome! Please select your room to reserve", 20)

    # --- rooms table -------------------------------------------------------
    panel(CX - 640, 150, CX + 640, 475)
    text(CX - 610, 190, "ROOM", 13, "w", color="#ffe08a")
    text(CX - 390, 190, "RATE / NIGHT", 13, "w", color="#ffe08a")
    text(CX - 215, 190, "MAX GUESTS", 13, "w", color="#ffe08a")
    text(CX + 270, 190, "", 12)
    for i, name in enumerate(ROOM_NAMES):
        r = ROOMS[name]
        y = 250 + i * 55
        text(CX - 610, y - 12, name, 15, "w")
        text(CX - 390, y - 12, peso(r["rate"]).replace("PHP ", "PHP ").split(".")[0], 14, "w")
        text(CX - 215, y - 12, f"{r['max']} (incl. {r['included']})", 14, "w")
        text(CX - 610, y + 14, r["specs"], 11, "w", font="Arial", color="#dddddd")
    text(CX + 270, 150 + 20, "", 10)

    today = date.today()
    draw_availability(
        date.fromisoformat(booking["checkin"]) if "checkin" in booking else today,
        booking.get("nights", 1))

    # --- inputs ------------------------------------------------------------
    lx, rx = CX - 300, CX + 300
    text(lx, 515, "Room type:", 16)
    room_cb = combo(lx, 550, ROOM_NAMES, booking.get("room", ""))
    text(rx, 515, "Date of Reservation: MONTH/DAY/YEAR", 16)
    date_e = entry(rx, 550, booking.get("date_str", today.strftime("%m/%d/%Y")))

    text(lx, 610, "Time of Reservation: ex. 7:00AM", 16)
    time_e = entry(lx, 645, booking.get("time", "2:00PM"))
    text(rx, 610, "How many nights will you stay? (1-30)", 16)
    nights_e = entry(rx, 645, str(booking.get("nights", 1)))

    text(lx, 705, "Number of guests:", 16)
    guests_e = entry(lx, 740, str(booking.get("guests", 1)))
    text(rx, 705, "(Extra guest fee: PHP 500/guest/night beyond included)", 12)
    text(rx, 740, "Discounts: 3-4 nights 5% off | 5+ nights 10% off", 12, color="#7CFC9A")

    def read_inputs():
        room = room_cb.get()
        if room not in ROOMS:
            raise ValueError("Please select a room type from the list.")
        d = parse_date(date_e.get())
        t = parse_time(time_e.get())
        if d < date.today():
            raise ValueError("The reservation date cannot be in the past.")
        if d > date.today() + timedelta(days=MAX_DAYS_AHEAD):
            raise ValueError(f"Reservations can only be made up to {MAX_DAYS_AHEAD} days ahead.")
        if datetime.combine(d, t) < datetime.now():
            raise ValueError("That check-in time has already passed today. Pick a later time.")
        nights = parse_int(nights_e.get(), "Number of nights", 1, MAX_NIGHTS)
        guests = parse_int(guests_e.get(), "Number of guests", 1, 99)
        if guests > ROOMS[room]["max"]:
            raise ValueError(f"{room} allows a maximum of {ROOMS[room]['max']} guests. "
                             "Please choose a bigger room or reduce guests.")
        return room, d, t, nights, guests

    def check_avail():
        try:
            d = parse_date(date_e.get())
            nights = parse_int(nights_e.get(), "Number of nights", 1, MAX_NIGHTS)
        except ValueError as e:
            messagebox.showerror("Check availability", str(e))
            return
        draw_availability(d, nights)

    def go_next():
        try:
            room, d, t, nights, guests = read_inputs()
        except ValueError as e:
            messagebox.showerror("Please check your input", str(e))
            return
        end = d + timedelta(days=nights)
        if rooms_left(room, d, end) <= 0:
            messagebox.showwarning(
                "Room not available",
                f"Sorry, all '{room}' rooms are booked for those dates.\n"
                "Try other dates or another room type.")
            draw_availability(d, nights)
            return
        booking.update(room=room, checkin=d.isoformat(), checkout=end.isoformat(),
                       date_str=date_e.get().strip(), time=t.strftime("%I:%M%p").lstrip("0"),
                       nights=nights, guests=guests)
        screen_guest()

    button(CX - 300, 830, "Check Availability", check_avail, 18)
    button(CX, 830, "Next", go_next, 14)
    button(CX + 300, 830, "Find / Cancel Booking", manage_booking, 22)
    text(CX, 900, "Tip: all fields are required. Prices shown are per room, per night.", 12,
         color="#dddddd")


# ----------------------------------------------------------------------------
# Screen 2: guest information + payment
# ----------------------------------------------------------------------------
def screen_guest():
    clear()
    p = compute_price(booking["room"], booking["nights"], booking["guests"])
    ci = date.fromisoformat(booking["checkin"])
    co = date.fromisoformat(booking["checkout"])

    text(CX, 80, "Guest Information", 28)
    panel(CX - 500, 130, CX + 500, 270)
    text(CX, 165, f"{booking['room']}  |  {booking['guests']} guest(s)  |  "
                  f"{booking['nights']} night(s)", 16)
    text(CX, 200, f"Check-in {ci.strftime('%b %d, %Y')} {booking['time']}   -   "
                  f"Check-out {co.strftime('%b %d, %Y')}", 14)
    text(CX, 238, f"Estimated total (incl. 12% VAT): {peso(p['total'])}", 16, color="#ffe08a")

    text(CX, 320, "Full name:", 18)
    name_e = entry(CX, 360, booking.get("name", ""), 36)
    text(CX, 420, "Contact Information: CP NO.", 18)
    cp_e = entry(CX, 460, booking.get("contact", ""), 36)
    text(CX, 520, "Payment method: ONLINE/CASH/BANKING", 18)
    pay_cb = combo(CX, 560, PAYMENT_METHODS, booking.get("payment", ""), 34)
    text(CX, 620, "Special requests (optional):", 18)
    req_e = entry(CX, 660, booking.get("requests", ""), 36)

    def collect():
        name = " ".join(name_e.get().split())
        if not re.fullmatch(r"[A-Za-z][A-Za-z .'\-]+", name):
            raise ValueError("Please enter a valid full name (letters only, at least 2 characters).")
        cp = re.sub(r"[\s\-]", "", cp_e.get())
        if not cp:
            raise ValueError("Contact number is required.")
        if not re.fullmatch(r"(09\d{9}|\+639\d{9})", cp):
            raise ValueError("Invalid contact number. Use 09XXXXXXXXX or +639XXXXXXXXX.")
        pay = pay_cb.get()
        if pay not in PAYMENT_METHODS:
            raise ValueError("Please choose a payment method.")
        req = req_e.get().strip()
        if len(req) > 80:
            raise ValueError("Special requests must be 80 characters or fewer.")
        return name, cp, pay, req

    def remember():
        booking.update(name=name_e.get(), contact=cp_e.get(),
                       payment=pay_cb.get(), requests=req_e.get())

    def go_back():
        remember()
        screen_booking()

    def confirm():
        try:
            name, cp, pay, req = collect()
        except ValueError as e:
            messagebox.showerror("Please check your input", str(e))
            return
        d = date.fromisoformat(booking["checkin"])
        end = date.fromisoformat(booking["checkout"])
        if rooms_left(booking["room"], d, end) <= 0:   # re-check right before saving
            messagebox.showwarning("Room not available",
                                   "Sorry, that room was just taken. Please pick other dates/room.")
            screen_booking()
            return
        total = compute_price(booking["room"], booking["nights"], booking["guests"])["total"]
        if not messagebox.askyesno(
                "Confirm reservation",
                f"Reserve {booking['room']} for {booking['nights']} night(s)?\n"
                f"Total: {peso(total)} ({pay})"):
            return
        record = {
            "ref": new_reference(), "room": booking["room"],
            "checkin": booking["checkin"], "checkout": booking["checkout"],
            "time": booking["time"], "nights": booking["nights"],
            "guests": booking["guests"], "name": name, "contact": cp,
            "payment": pay, "requests": req, "total": round(total, 2),
            "created": datetime.now().strftime("%b %d, %Y %I:%M %p"),
        }
        bookings.append(record)
        if not save_bookings():
            bookings.pop()
            return
        screen_receipt(record)

    button(CX - 150, 760, "Back", go_back, 14)
    button(CX + 150, 760, "Confirm Reservation", confirm, 20)


# ----------------------------------------------------------------------------
# Screen 3: receipt
# ----------------------------------------------------------------------------
def screen_receipt(record):
    clear()
    receipt = build_receipt(record)

    saved_path = None
    try:
        os.makedirs(RECEIPT_DIR, exist_ok=True)
        saved_path = os.path.join(RECEIPT_DIR, f"{record['ref']}.txt")
        with open(saved_path, "w", encoding="utf-8") as f:
            f.write(receipt)
    except OSError as e:
        messagebox.showwarning("Receipt file", f"Could not auto-save the receipt file:\n{e}")
        saved_path = None

    def D(px):
        """Convert real pixels to the 1000-based design units used by text()/place()."""
        return px * 1000 / H

    fsize, lh = (12, 21) if H >= 900 else (10, 17)
    n_lines = receipt.count("\n") + 1
    top = 70
    bottom = top + n_lines * lh + 20
    text(CX, D(35), "Reservation Confirmed!", 26, color="#7CFC9A")
    panel(CX - 320, D(top), CX + 320, D(bottom))
    text(CX, D(top + 10), receipt, fsize, "n", font="Courier New")
    foot_y = D(bottom + 25)
    if saved_path:
        text(CX, foot_y, f"Saved to: receipts/{record['ref']}.txt", 11, color="#dddddd")
    foot_y = D(bottom + 25)

    def save_as():
        path = filedialog.asksaveasfilename(
            defaultextension=".txt", initialfile=f"{record['ref']}.txt",
            filetypes=[("Text file", "*.txt")])
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(receipt)
            messagebox.showinfo("Saved", "Receipt saved.")
        except OSError as e:
            messagebox.showerror("Save error", f"Could not save the file:\n{e}")

    def new_res():
        booking.clear()
        screen_booking()

    button(CX - 200, foot_y + D(45), "Save Receipt As...", save_as, 20)
    button(CX + 200, foot_y + D(45), "New Reservation", new_res, 20)


# ----------------------------------------------------------------------------
# Extra: find / cancel a booking by reference number
# ----------------------------------------------------------------------------
def manage_booking():
    ref = simpledialog.askstring("Find booking", "Enter your reference number (e.g. ESM-AB12CD):",
                                 parent=window)
    if ref is None:
        return
    ref = ref.strip().upper()
    if not ref:
        messagebox.showerror("Find booking", "Please enter a reference number.")
        return
    rec = next((b for b in bookings if b["ref"] == ref), None)
    if not rec:
        messagebox.showinfo("Find booking", f"No reservation found for '{ref}'.")
        return
    info = (f"Ref: {rec['ref']}\nGuest: {rec['name']}\nRoom: {rec['room']}\n"
            f"Check-in: {rec['checkin']} {rec['time']}\nNights: {rec['nights']}\n"
            f"Guests: {rec['guests']}\nTotal: {peso(rec['total'])}")
    if date.fromisoformat(rec["checkin"]) < date.today():
        messagebox.showinfo("Reservation details", info + "\n\n(Past stays cannot be cancelled.)")
        return
    if messagebox.askyesno("Reservation details", info + "\n\nCancel this reservation?"):
        bookings.remove(rec)
        if save_bookings():
            messagebox.showinfo("Cancelled", "The reservation has been cancelled.")
        else:
            bookings.append(rec)


# ----------------------------------------------------------------------------
screen_booking()
window.mainloop()
